# TalhaGPT example environment configuration
# Copy this file to .env and adjust the values for your environment.
# Never commit the real .env file or place secrets in this template.

# -----------------------------------------------------------------------------
# Model configuration
# -----------------------------------------------------------------------------

# Ollama model used for text conversations.
MODEL_NAME=qwen3:8b

# Ollama server URL for a native installation.
# Docker Compose overrides this value with http://ollama:11434 automatically.
OLLAMA_HOST=http://localhost:11434

# Ollama vision model used by image analysis tools.
VISION_MODEL=llava

# -----------------------------------------------------------------------------
# Voice configuration
# -----------------------------------------------------------------------------

# Language used by text-to-speech when voice output is enabled.
TTS_LANGUAGE=tr

# Set to True, 1, or yes to enable startup text-to-speech.
ENABLE_VOICE=False

# -----------------------------------------------------------------------------
# Tool safety
# -----------------------------------------------------------------------------

# Ask for confirmation before running sensitive tools such as launch_app
# and capture_screen. Recommended value: True.
REQUIRE_TOOL_CONFIRM=True

# -----------------------------------------------------------------------------
# Optional user preferences
# -----------------------------------------------------------------------------

# Optional preferred name or form of address. Leave empty for natural addressing.
# USER_ADDRESS=
